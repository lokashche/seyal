# Settings for Seyal on a server. Copy to deploy/.env on the server, replace every "change-me",
# and keep it private (chmod 600). Never commit deploy/.env.
# Make passwords long and random, e.g.:  openssl rand -base64 24 | tr -d '/+='

# How people reach Seyal over HTTPS: tunnel (Cloudflare Tunnel, no open ports) or caddy (ports 80/443).
COMPOSE_PROFILES=tunnel
# For the tunnel: the token Cloudflare shows when you create the tunnel (Zero Trust → Networks → Tunnels).
CLOUDFLARE_TUNNEL_TOKEN=
# For Caddy only: the address people open (its DNS A record points at this server), and where
# Let's Encrypt sends certificate notices.
SEYAL_DOMAIN=
ACME_EMAIL=

# Which Seyal image to run. Released images: ghcr.io/<github-owner>/seyal:<version>, e.g. v0.1.0.
# Leave as seyal:local to build from this copy of the code instead ("docker compose build").
SEYAL_IMAGE=seyal:local

# Database passwords (used inside the server only).
POSTGRES_PASSWORD=change-me-superuser
SEYAL_OWNER_PASSWORD=change-me-owner
SEYAL_APP_PASSWORD=change-me-app
# Same passwords again, in the addresses Seyal uses. The host is "postgres" (the database service).
SEYAL_OWNER_DATABASE_URL=postgres://seyal_owner:change-me-owner@postgres:5432/seyal?sslmode=disable
SEYAL_DATABASE_URL=postgres://seyal_app:change-me-app@postgres:5432/seyal?sslmode=disable

# AI (optional). Leave empty to keep AI off. Check the provider's data policy before real client
# details go to it. Format and prices: see the main .env.example.
SEYAL_AI_UNDERSTAND=
SEYAL_AI_UNDERSTAND_PRICE=
SEYAL_AI_DRAFT=
SEYAL_AI_DRAFT_PRICE=
# Voice notes to words (optional; the recording itself goes to the provider, so check its terms for audio).
SEYAL_AI_TRANSCRIBE=
SEYAL_AI_TRANSCRIBE_PRICE=
SEYAL_AI_TRANSCRIBE_LANGUAGE=
# Most minutes of audio in any 24 hours, per business and per login (empty = 240 and 60).
SEYAL_AI_TRANSCRIBE_DAY_MINUTES=
SEYAL_AI_TRANSCRIBE_LOGIN_DAY_MINUTES=
# Tidy the words of voice notes ("umm"s, repeats) with a chat model (optional; it gets the words only).
SEYAL_AI_TIDY=
SEYAL_AI_TIDY_PRICE=
SEYAL_GROQ_API_KEY=
SEYAL_OPENAI_API_KEY=
SEYAL_USD_INR=88

# Phone notes (web push). Off until the maintainer agrees (it calls Google's, Apple's, Mozilla's or
# Microsoft's push service, and even turning it on in a browser does). "on" needs the two keys printed
# by `seyal push keys` (keep the private one secret and backed up) and a contact address the push
# services may write to: mailto:you@yourfirm.example or https://...
SEYAL_PUSH=off
SEYAL_PUSH_PUBLIC_KEY=
SEYAL_PUSH_PRIVATE_KEY=
SEYAL_PUSH_CONTACT=

# The Share panel's WhatsApp button (a chat link). Off until the maintainer agrees: when the link opens
# in a browser (a computer, and sometimes a phone), WhatsApp's website sees the words in the address.
# Email, Copy and More... need no switch, because nothing leaves the Seyal server for them.
SEYAL_SHARE_CHAT_LINKS=off

# Sending to other apps (a Google Sheet's script, n8n, Make, Zapier). Off until the maintainer agrees:
# "on" lets Seyal post to the other apps a business's private set-up file lists (other_apps:), and only
# to the hosts written here, comma-separated, with no https:// and no port, for example
# script.google.com,script.googleusercontent.com,hook.eu1.make.com. Each host is one agreed outward flow.
SEYAL_SEND=off
SEYAL_SEND_HOSTS=
