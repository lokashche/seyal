# Copy this file to .env and replace every "change-me" value. Never commit .env.

# Postgres superuser password (used only inside the database container).
POSTGRES_PASSWORD=change-me-superuser

# Port on this computer for the local database.
SEYAL_DB_PORT=5432

# Owner role: runs migrations.
SEYAL_OWNER_PASSWORD=change-me-owner
# App role: used by the running server (restricted, row-level security always on).
SEYAL_APP_PASSWORD=change-me-app

# Connection strings (keep the passwords in sync with the values above).
SEYAL_OWNER_DATABASE_URL=postgres://seyal_owner:change-me-owner@localhost:5432/seyal?sslmode=disable
SEYAL_DATABASE_URL=postgres://seyal_app:change-me-app@localhost:5432/seyal?sslmode=disable
SEYAL_TEST_OWNER_DATABASE_URL=postgres://seyal_owner:change-me-owner@localhost:5432/seyal_test?sslmode=disable
SEYAL_TEST_DATABASE_URL=postgres://seyal_app:change-me-app@localhost:5432/seyal_test?sslmode=disable


# Where the web app listens. 127.0.0.1 = this computer only.
SEYAL_ADDR=127.0.0.1:8080
# Set to true when Seyal is reached over HTTPS (cookies are then sent only over HTTPS).
SEYAL_SECURE_COOKIES=false

# Folder for voice notes and other files people send. Back it up together with the database.
SEYAL_MEDIA_DIR=data/media

# Folders with playbooks and master-data kinds. Leave empty to use the samples in examples/.
SEYAL_PLAYBOOKS_DIR=
SEYAL_MASTERS_DIR=
