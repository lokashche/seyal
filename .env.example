# Copy this file to .env and replace every "change-me" value. Never commit .env.

# Postgres superuser password (used only inside the database container).
POSTGRES_PASSWORD=change-me-superuser

# Port on this computer for the local database.
SEYAL_DB_PORT=5432

# Owner role: runs migrations.
SEYAL_OWNER_PASSWORD=change-me-owner
# App role: used by the running server (restricted, row-level security always on).
SEYAL_APP_PASSWORD=change-me-app

# Connection strings (keep the passwords in sync with the values above).
SEYAL_OWNER_DATABASE_URL=postgres://seyal_owner:change-me-owner@localhost:5432/seyal?sslmode=disable
SEYAL_DATABASE_URL=postgres://seyal_app:change-me-app@localhost:5432/seyal?sslmode=disable
SEYAL_TEST_OWNER_DATABASE_URL=postgres://seyal_owner:change-me-owner@localhost:5432/seyal_test?sslmode=disable
SEYAL_TEST_DATABASE_URL=postgres://seyal_app:change-me-app@localhost:5432/seyal_test?sslmode=disable


# Where the web app listens. 127.0.0.1 = this computer only.
SEYAL_ADDR=127.0.0.1:8080
# Set to true when Seyal is reached over HTTPS (cookies are then sent only over HTTPS).
SEYAL_SECURE_COOKIES=false

# Folder for voice notes and other files people send. Back it up together with the database.
SEYAL_MEDIA_DIR=data/media

# AI (optional). Each kind of AI work can use its own model, written as provider:model.
# Leave empty to keep AI off: Seyal then asks its questions one by one.
# Kinds: UNDERSTAND (read chat messages), DRAFT (draft processes), TIDY (voice transcripts),
# SUMMARIZE (summaries). Prices are US$ per million tokens: input,cached,cache-write,output
# (they change; copy them from your provider's price page). "fake" exists only for tests and
# demos and understands nothing.
SEYAL_AI_UNDERSTAND=
SEYAL_AI_UNDERSTAND_PRICE=
SEYAL_AI_DRAFT=
SEYAL_AI_DRAFT_PRICE=
SEYAL_AI_TIDY=
SEYAL_AI_TIDY_PRICE=
SEYAL_AI_SUMMARIZE=
SEYAL_AI_SUMMARIZE_PRICE=
# Providers: groq:<model>, openai:<model>, or compat:<model> for any other OpenAI-style service (e.g.
# Ollama on this computer). Take the model name from the provider's model list, e.g.
# SEYAL_AI_UNDERSTAND=groq:<model>. Prices are on the provider's pricing page.
# Keys stay here (this file is private); they never appear in the app or the repo.
SEYAL_GROQ_API_KEY=
SEYAL_OPENAI_API_KEY=
SEYAL_COMPAT_BASE_URL=
SEYAL_COMPAT_API_KEY=

# Rupees per US dollar, for showing AI costs in rupees (check today's rate).
SEYAL_USD_INR=88

# Template folders: sample processes and lists that every business on this server may start from.
# Leave empty to use the samples in examples/. A business's own processes and lists are kept in the
# database (Settings); private starting files go next to its set-up file, not here.
SEYAL_PLAYBOOKS_DIR=
SEYAL_MASTERS_DIR=
